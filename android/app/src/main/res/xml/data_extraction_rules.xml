<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in tokens and call data never leave the device through backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
