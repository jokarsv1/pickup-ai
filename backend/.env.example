# Pickup backend configuration. Copy to .env and fill in what you have.
# Everything marked [YOU] is an external account or key only you can create (see docs/SETUP.md).

# --- Core -------------------------------------------------------------------
ENV=dev                                   # dev | prod  (dev enables the fixed-OTP login)
PUBLIC_BASE_URL=https://api.example.com   # [YOU] public HTTPS URL of this server (ngrok works for testing)
DATABASE_URL=sqlite+aiosqlite:///./pickup.db
REDIS_URL=                                # redis://localhost:6379/0 for multi-instance deployments
JWT_SECRET=change-me-to-64-random-characters-change-me-to-64-random-chars
ADMIN_TOKEN=change-me-admin-token         # protects /admin (loading phone numbers)
DEFAULT_COUNTRY=IN

# --- Sign-in ----------------------------------------------------------------
FIREBASE_PROJECT_ID=                      # [YOU] Firebase project id (phone auth)
DEV_AUTH_ENABLED=true                     # fixed code login when ENV=dev
DEV_AUTH_CODE=123456

BETA_LOGIN_NUMBERS=                       # your test numbers, e.g. +919876543210,+919812345678
BETA_LOGIN_CODE=                          # a 6+ digit code only you know; lets those numbers sign in without SMS

# --- Push notifications (Firebase Cloud Messaging) --------------------------
FCM_SERVICE_ACCOUNT_FILE=                 # [YOU] path to the Firebase service-account JSON
FCM_SERVICE_ACCOUNT_JSON=                 # ...or the JSON itself

# --- AI ---------------------------------------------------------------------
ANTHROPIC_API_KEY=                        # [YOU] Claude: live calls, summaries, assistant chat
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_LIVE_EFFORT=low
STT_PROVIDER=sarvam                       # sarvam (Indian languages) | deepgram
TTS_PROVIDER=sarvam                       # sarvam | elevenlabs | cartesia
SARVAM_API_KEY=                           # [YOU] Saaras v3 speech-to-text + Bulbul v3 voices
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# --- Telephony --------------------------------------------------------------
TELEPHONY_PROVIDER=exotel                 # exotel (India) | plivo | twilio (outside India)
TELEPHONY_WEBHOOK_SECRET=change-me-webhook-secret   # goes into the Exotel flow URLs
EXOTEL_ACCOUNT_SID=                       # [YOU]
EXOTEL_API_KEY=                           # [YOU]
EXOTEL_API_TOKEN=                         # [YOU]
EXOTEL_SUBDOMAIN=api.exotel.com           # api.in.exotel.com for the Mumbai cluster
EXOTEL_OUTBOUND_FLOW_ID=                  # [YOU] id of the outbound flow (Voicebot applet)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MAX_CALL_SECONDS=300

# --- Storage ----------------------------------------------------------------
RECORDINGS_DIR=./recordings
S3_BUCKET=                                # any S3-compatible bucket for production
S3_REGION=ap-south-1
S3_ENDPOINT_URL=

# --- Legal pages (served at /legal/privacy and /legal/terms) -------------------
LEGAL_ENTITY_NAME=Pickup                  # [YOU] your company or your own name
LEGAL_ADDRESS=India                       # [YOU] postal address shown on the legal pages
LEGAL_JURISDICTION_CITY=Bengaluru
SUPPORT_EMAIL=support@example.com         # [YOU] where users and callers can reach you
GRIEVANCE_OFFICER=The Pickup team         # [YOU] name of the person who handles complaints (DPDP Act)

# --- Plans ------------------------------------------------------------------
TRIAL_DAYS=7
FREE_CALLS_PER_MONTH=15
GOOGLE_PLAY_PACKAGE_NAME=ai.pickup.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=         # [YOU] service account with Play Developer API access
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=         # or the same file's contents (used on Fly.io)
